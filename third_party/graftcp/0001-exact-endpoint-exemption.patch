+/* Modified 2026-10-09 for Alpine Proxy Manager (https://github.com/csjcsl666/alpine-proxy-manager,
+ * third_party/graftcp): exact endpoint exemptions.
+ * GRAFTCP_DIRECT_ENDPOINTS="tcp:127.0.0.53:53,udp:127.0.0.53:53" lists IPv4
+ * endpoints that are never redirected (protocol, address and port must all
+ * match). GRAFTCP_LOOPBACK_UDP_COMM=<name> lets processes with that comm send
+ * UDP to 127.0.0.0/8 directly (replies of a local resolver). Both are read
+ * once and removed from the environment so tracees do not inherit them. A
+ * malformed value is fatal, never silently ignored. */
+#define APM_MAX_DIRECT_EP 8
+static struct {
+	bool stream;
+	uint32_t ip; /* network byte order */
+	uint16_t port;
+} APM_DIRECT_EP[APM_MAX_DIRECT_EP];
+static int APM_DIRECT_EP_N;
+static char APM_LOOPBACK_UDP_COMM[16];
+
 
 static uid_t run_uid;
 static gid_t run_gid;
