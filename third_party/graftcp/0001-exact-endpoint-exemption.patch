 }
 
+static void apm_parse_direct_endpoints(void)
+{
+	char *env = getenv("GRAFTCP_DIRECT_ENDPOINTS");
+	char *copy, *tok, *save = NULL;
+
+	if (env == NULL)
+		return;
+	copy = xstrdup(env);
+	unsetenv("GRAFTCP_DIRECT_ENDPOINTS");
+	for (tok = strtok_r(copy, ",", &save); tok;
+	     tok = strtok_r(NULL, ",", &save)) {
+		char *colon = strchr(tok, ':');
+		char *pcolon = colon ? strrchr(colon + 1, ':') : NULL;
+		struct in_addr a;
+		char *end = NULL;
+		long port;
+		bool stream;
+
+		if (colon == NULL || pcolon == NULL ||
+		    APM_DIRECT_EP_N >= APM_MAX_DIRECT_EP)
+			goto bad;
+		*colon = '\0';
+		*pcolon = '\0';
+		if (strcmp(tok, "tcp") == 0)
+			stream = true;
+		else if (strcmp(tok, "udp") == 0)
+			stream = false;
+		else
+			goto bad;
+		if (inet_pton(AF_INET, colon + 1, &a) != 1)
+			goto bad;
+		port = strtol(pcolon + 1, &end, 10);
+		if (end == pcolon + 1 || *end != '\0' || port < 1 || port > 65535)
+			goto bad;
+		APM_DIRECT_EP[APM_DIRECT_EP_N].stream = stream;
+		APM_DIRECT_EP[APM_DIRECT_EP_N].ip = a.s_addr;
+		APM_DIRECT_EP[APM_DIRECT_EP_N].port = (uint16_t)port;
+		APM_DIRECT_EP_N++;
+	}
+	free(copy);
+	return;
+bad:
+	fprintf(stderr, "invalid GRAFTCP_DIRECT_ENDPOINTS\n");
+	exit(1);
+}
+
+static void apm_parse_loopback_udp_comm(void)
+{
+	char *env = getenv("GRAFTCP_LOOPBACK_UDP_COMM");
+
+	if (env == NULL)
+		return;
+	if (env[0] == '\0' || strlen(env) >= sizeof(APM_LOOPBACK_UDP_COMM)) {
+		fprintf(stderr, "invalid GRAFTCP_LOOPBACK_UDP_COMM\n");
+		exit(1);
+	}
+	strcpy(APM_LOOPBACK_UDP_COMM, env);
+	unsetenv("GRAFTCP_LOOPBACK_UDP_COMM");
+}
+
+static bool apm_dest_is_direct_endpoint(const struct dest_endpoint *dest,
+					bool stream)
+{
+	int i;
+
+	if (dest->family != AF_INET)
+		return false;
+	for (i = 0; i < APM_DIRECT_EP_N; i++) {
+		if (APM_DIRECT_EP[i].stream == stream &&
+		    APM_DIRECT_EP[i].ip == dest->sa.v4.sin_addr.s_addr &&
+		    APM_DIRECT_EP[i].port == dest->port)
+			return true;
+	}
+	return false;
+}
+
+static bool apm_udp_loopback_reply(pid_t pid, const struct dest_endpoint *dest)
+{
+	char path[64], comm[32];
+	FILE *f;
+	size_t n;
+
+	if (APM_LOOPBACK_UDP_COMM[0] == '\0' || dest->family != AF_INET ||
+	    (ntohl(dest->sa.v4.sin_addr.s_addr) >> 24) != 127)
+		return false;
+	snprintf(path, sizeof(path), "/proc/%d/comm", (int)pid);
+	f = fopen(path, "r");
+	if (f == NULL)
+		return false;
+	n = fread(comm, 1, sizeof(comm) - 1, f);
+	fclose(f);
+	comm[n] = '\0';
+	if (n > 0 && comm[n - 1] == '\n')
+		comm[n - 1] = '\0';
+	return strcmp(comm, APM_LOOPBACK_UDP_COMM) == 0;
+}
