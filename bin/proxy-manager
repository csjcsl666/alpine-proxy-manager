#!/bin/sh
# Alpine Proxy Manager 主入口
# 仅使用 POSIX sh 与 BusyBox 工具

set -u

_self=$(readlink -f -- "$0") || { echo "无法解析自身路径" >&2; exit 1; }
APM_HOME=${_self%/*}
APM_HOME=${APM_HOME%/*}
export APM_HOME

for _m in common environment state core model policy txn report client snell snellnet singbox manager tui; do
    # shellcheck source=/dev/null
    . "$APM_HOME/lib/$_m.sh" || { echo "加载 lib/$_m.sh 失败" >&2; exit 1; }
done

usage() {
    cat <<EOF
用法: proxy-manager <命令>
短命令 apm 与 proxy-manager 完全等价 在交互式终端直接运行 apm 进入管理界面

命令:
  --version     显示版本与 Build
  doctor        只读环境检查
  core list     列出 Core 及状态 (只读发现)
  snell status | info | log [N]       Snell 状态 事实 日志 (只读)
  snell install [--release 标签] [--port 端口 | --listen 列表] [--psk-stdin]
  snell start | stop | restart         仅限 Manager 安装的 Snell
  snell config [show]                  显示配置 (PSK 脱敏)
  snell config set listen|mode 值      修改配置 失败自动恢复
  snell config set psk --stdin | --generate
  snell update [标签] [--force]        更新二进制 失败自动回滚
  snell uninstall [--purge]            卸载 默认保留配置与日志
  snell egress [show | set --server 地址 --port 端口 (--no-auth | --username 名 --password-stdin) [--dns-server IP]
                | enable [--yes] | disable]     SOCKS5 出口 Snell 的 TCP UDP DNS 全部经指定上游 上游故障时失败 不直连
  snell access [show | add 主机 端口 | delete 主机 端口 | clear | refresh | enable [--yes] | disable]
                                       目标访问限制 只允许名单里的 地址:端口 其余全部拒绝 只转发 TCP
  sing-box status | info | log [N] | check            状态 事实 日志 配置检查
  sing-box install [--release 标签]    下载官方 musl release 安装并启动 默认 v1.13.14
  sing-box start | stop | restart
  sing-box update [标签] [--force]     更新二进制 先用新二进制检查当前配置 失败自动回滚
  sing-box uninstall [--purge]         卸载 默认保留配置 证书 日志与实例
  sing-box add anytls|hysteria2|tuic|shadowsocks [--name ID] [--port N | --listen ADDR] [--password-stdin]
                [--server-name 名 (TLS 协议)] [--uuid UUID --congestion-control cubic|new_reno|bbr (tuic)]
                [--method 方法 (shadowsocks, 默认 2022-blake3-aes-128-gcm)]
  sing-box list | show ID
  sing-box enable ID | disable ID | delete ID
  sing-box set ID port|listen|server-name|congestion-control 值 | set ID uuid UUID|--generate
  sing-box set ID password --stdin|--generate | set ID method 方法 [--stdin|--generate]
  sing-box access ID [show|unrestricted|allowlist|clear | add 地址 端口 | delete 地址 端口]  目标访问限制 (按实例, 跨协议)
  sing-box socks list | show 名称 | add --server 地址 --port 端口 (--no-auth | --username 名 --password-stdin) [--name 名称]
  sing-box socks set 名称 server|port|no-auth|credential 用户名 --password-stdin|password --password-stdin
  sing-box socks enable|disable 名称... | enable-all | disable-all | delete 名称   SOCKS 出口 Profile
  sing-box egress ID [show] | direct | socks 名称   实例出口 (DIRECT 或 SOCKS Profile, 不自动切换)
  sing-box endpoint ID [show] | set 主机 端口 | clear   客户端连接地址 (Public Endpoint, 不配置 NAT, 不重启)
  sing-box export ID show | secret | sing-box [--redacted] [--embed-cert] | url | qr   客户端导出 (secret url qr 包含凭据)
  snell endpoint [show] | set 主机 端口 | clear   Snell 客户端连接地址
  snell export info | show | secret   Snell 客户端信息 info 按需查询公网 IP 不需要先设置客户端连接地址 show 使用已设置的客户端连接地址 secret 显示 PSK
  manager check-update   检查 GitHub 最新正式 Release 只查询 不下载 非 root 也可以
  manager update         更新 Manager 本身 只用最新正式 Release 复用安装器 需要 root 不重启 Snell 与 sing-box
  tui           统一 TUI 管理界面 (交互式终端中直接运行 proxy-manager 也会进入)
  help          显示本帮助
EOF
}

# 无参数: 交互式终端进入 TUI, 其他情况保持原来的帮助输出, 脚本与管道不受影响
if [ $# -eq 0 ] && [ -t 0 ] && [ -t 1 ]; then
    tui_cli
    exit $?
fi

case ${1:-help} in
    tui) tui_cli; exit $? ;;
    --version|-V|version) apm_print_version ;;
    doctor) report_doctor ;;
    status) report_status ;;
    core)
        case ${2:-list} in
            list) report_core_list ;;
            *) apm_err "未知的 core 子命令: $2"; usage >&2; exit 2 ;;
        esac
        ;;
    snell) shift; snell_cli "$@"; exit $? ;;
    manager) shift; manager_cli "$@"; exit $? ;;
    sing-box|singbox) shift; singbox_cli "$@"; exit $? ;;
    help|--help|-h) usage ;;
    *) apm_err "未知命令: $1"; usage >&2; exit 2 ;;
esac
